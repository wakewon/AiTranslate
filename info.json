{
  "identifier": "com.github.wakewon.ai.translate",
  "version": "1.2.0",
  "category": "translate",
  "name": "Ai 翻译",
  "summary": "在 Bob 中连接云端或本地模型，支持 OpenAI、Claude 和 Gemini 等接口格式。",
  "icon": "icon.png",
  "author": "wakewon",
  "homepage": "https://wakewon.wwang.de/AiTranslate/",
  "tutorial": "https://wakewon.wwang.de/AiTranslate/docs/basic-usage.html",
  "appcast": "https://raw.githubusercontent.com/wakewon/AiTranslate/main/appcast.json",
  "minBobVersion": "1.8.0",
  "options": [
    {
      "identifier": "format",
      "type": "menu",
      "title": "请求格式",
      "defaultValue": "openai_chat",
      "desc": "按配置助手的说明选择。多数服务可以保留默认的 OpenAI Chat Completions。",
      "menuValues": [
        {
          "title": "OpenAI Chat Completions（通用兼容）",
          "value": "openai_chat"
        },
        {
          "title": "OpenAI Responses API",
          "value": "openai_responses"
        },
        {
          "title": "OpenAI Legacy Completions",
          "value": "openai_completions"
        },
        {
          "title": "Anthropic Claude Messages",
          "value": "anthropic_messages"
        },
        {
          "title": "Anthropic OpenAI 兼容",
          "value": "anthropic_openai_chat"
        },
        {
          "title": "Gemini generateContent",
          "value": "gemini_generate_content"
        },
        {
          "title": "Gemini OpenAI 兼容",
          "value": "gemini_openai_chat"
        }
      ]
    },
    {
      "identifier": "baseURL",
      "type": "text",
      "title": "Base URL",
      "desc": "把配置助手列出的 Base URL 粘贴到这里。这是 Bob 发送原文的服务地址。",
      "textConfig": {
        "type": "visible",
        "height": 40,
        "placeholderText": "粘贴服务地址"
      }
    },
    {
      "identifier": "endpointOverride",
      "type": "text",
      "title": "端点路径覆盖",
      "desc": "通常留空，插件会自动补上路径。如果配置助手列出了这项，请复制完整路径，包括开头的 /。手动填写 Gemini 路径时要写出实际模型名。",
      "textConfig": {
        "type": "visible",
        "height": 40,
        "placeholderText": "留空使用默认路径"
      }
    },
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key",
      "desc": "需要密钥时，粘贴服务商给你的 API Key。使用 bilibili 公共服务，或使用未开启密钥验证的本机模型时，可以留空。多个密钥用英文逗号隔开。",
      "textConfig": {
        "type": "secure",
        "height": 40,
        "placeholderText": "按服务要求填写"
      }
    },
    {
      "identifier": "authMode",
      "type": "menu",
      "title": "鉴权方式",
      "defaultValue": "auto",
      "desc": "通常保留「自动」。如果配置助手列出了这一项，请按它给的名称选择。它决定 Bob 怎样把密钥交给服务商。",
      "menuValues": [
        {
          "title": "自动（按请求格式）",
          "value": "auto"
        },
        {
          "title": "Authorization: Bearer",
          "value": "authorization"
        },
        {
          "title": "x-api-key",
          "value": "x-api-key"
        },
        {
          "title": "x-goog-api-key",
          "value": "x-goog-api-key"
        },
        {
          "title": "api-key",
          "value": "api-key"
        },
        {
          "title": "URL 查询参数 key",
          "value": "query-key"
        },
        {
          "title": "手动或无需鉴权",
          "value": "none"
        }
      ]
    },
    {
      "identifier": "model",
      "type": "text",
      "title": "模型",
      "desc": "复制配置助手或服务商列出的完整模型名称。Azure OpenAI 要填自己的部署名，本机服务要填已加载的模型名。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "服务商提供的模型 ID"
      }
    },
    {
      "identifier": "customSystemPrompt",
      "type": "text",
      "title": "自定义系统指令",
      "defaultValue": "",
      "desc": "日常翻译可以留空。想固定译文风格时，在这里写下要求，例如「保留术语和段落，只输出译文」。",
      "textConfig": {
        "type": "visible",
        "height": 120,
        "keyWords": [
          "$text",
          "$sourceLang",
          "$targetLang"
        ],
        "placeholderText": "You are a translation engine that can only translate text and cannot interpret it."
      }
    },
    {
      "identifier": "customUserPrompt",
      "type": "text",
      "title": "自定义用户指令",
      "defaultValue": "",
      "desc": "日常翻译可以留空。自己编写时请保留 $text，插件会用原文替换它。$sourceLang 和 $targetLang 会分别替换为原文语言和译文语言。",
      "textConfig": {
        "type": "visible",
        "height": 120,
        "keyWords": [
          "$text",
          "$sourceLang",
          "$targetLang"
        ],
        "placeholderText": "translate from $sourceLang to $targetLang:\n\n$text"
      }
    },
    {
      "identifier": "stream",
      "type": "menu",
      "title": "流式输出",
      "defaultValue": "enable",
      "menuValues": [
        {
          "title": "开启",
          "value": "enable"
        },
        {
          "title": "关闭",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "markdown",
      "type": "menu",
      "title": "Markdown 渲染",
      "defaultValue": "enable",
      "desc": "开启后，译文可以显示标题、列表和表格。需要查看原始代码或标记时可关闭。此功能需要 Bob 1.21.0 及以上和 macOS 13 及以上，较早版本显示纯文本。",
      "menuValues": [
        {
          "title": "开启",
          "value": "enable"
        },
        {
          "title": "关闭",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "maxOutputTokens",
      "type": "text",
      "title": "最大输出 Token",
      "desc": "可选。限制输出长度，留空则使用模型默认值。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "留空使用默认值"
      }
    },
    {
      "identifier": "temperature",
      "type": "text",
      "title": "温度",
      "desc": "可选。控制输出的随机性，值越低翻译越稳定。留空则不发送此参数。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "例如 0.2"
      }
    },
    {
      "identifier": "extraHeaders",
      "type": "text",
      "title": "额外请求头 (JSON)",
      "desc": "可选。JSON 格式的额外 HTTP 请求头。与默认头同名时，以此处设置为准，名称不区分大小写。可用于自定义鉴权。\n\n示例：{\"Authorization\": \"Bearer YOUR_TOKEN\"}",
      "textConfig": {
        "type": "visible",
        "height": 100,
        "placeholderText": "{}"
      }
    },
    {
      "identifier": "extraQuery",
      "type": "text",
      "title": "额外查询参数 (JSON)",
      "desc": "可选。JSON 格式的 URL 查询参数，会附加到请求 URL 上。\n\n示例: {\"api-version\": \"2024-02-01\"}",
      "textConfig": {
        "type": "visible",
        "height": 100,
        "placeholderText": "{}"
      }
    },
    {
      "identifier": "extraBody",
      "type": "text",
      "title": "额外请求体 (JSON)",
      "desc": "关闭思考或调整强度时，在配置助手的「思考设置」中选择模型与档位，将生成的 JSON 填入此处。使用模型默认设置可留空。",
      "textConfig": {
        "type": "visible",
        "height": 140,
        "placeholderText": "{}"
      }
    }
  ]
}
